# Template for the ESPHome secrets used by sc01_thermostat.yaml.
#
# The REAL secrets.yaml lives inside the ESPHome add-on in Home Assistant,
# NOT in this repo (repo is public). This file only documents which keys the
# config references, so a fresh setup knows what to provide.
#
# Note: the API encryption key is referenced as `secre_key` (sic) to match the
# existing add-on secrets; keep the name identical there or the build fails.

secre_key: "BASE64_API_ENCRYPTION_KEY"     # 32-byte base64 key (ESPHome generates one)
ota_password: "OTA_PASSWORD"
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
fallback_ssid_password: "AP_FALLBACK_PASSWORD"   # captive-portal AP password
